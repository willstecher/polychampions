---
interface Props {
  question: string;
  open?: boolean;
}
const { question, open = false } = Astro.props;
---
<details class="acc" open={open}>
  <summary>
    <span class="q">{question}</span>
    <span class="plus" aria-hidden="true">+</span>
  </summary>
  <div class="body">
    <slot />
  </div>
</details>

<style>
  .acc {
    border: var(--border-strong);
    border-radius: 10px;
    background: var(--paper-2);
    padding: 18px 22px;
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  summary::-webkit-details-marker { display: none; }
  .q {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }
  .plus {
    font-size: 22px;
    line-height: 1;
    font-weight: 600;
    color: var(--brand);
    transition: transform .15s;
    flex-shrink: 0;
  }
  .acc[open] .plus {
    transform: rotate(45deg);
  }
  .body {
    padding-top: 14px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .body :global(p) { margin: 0 0 1em 0; }
  .body :global(p:last-child) { margin-bottom: 0; }
  .body :global(ul) { padding-left: 1.2em; margin: 0 0 1em 0; }
  .body :global(li) { margin-bottom: 0.4em; }
</style>
