---
import { social } from '../data/league';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/teams', label: 'Teams' },
  { href: '/join', label: 'Join' },
  { href: '/faq', label: 'FAQ' },
  { href: '/league-rules', label: 'Rules' },
  { href: '/news', label: 'News' },
  { href: '/history', label: 'History' },
];
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---
<header class="site-header">
  <div class="inner">
    <a href="/" class="brand" aria-label="PolyChampions home">
      <img
        src="/logo.png"
        alt=""
        width="36"
        height="36"
        class="brand-logo"
        decoding="async"
      />
      <span class="wordmark">PolyChampions</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} class:list={["nav-link", { active: isActive(n.href) }]}>
          {n.label}
        </a>
      ))}
    </nav>
    <div class="right">
      <a
        href={social.merch}
        target="_blank"
        rel="noopener"
        class="merch"
      >
        Merch <span aria-hidden="true">↗</span>
      </a>
      <a
        href={social.discord}
        target="_blank"
        rel="noopener"
        class="discord-cta"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.07.07 0 0 0-.074.034c-.211.375-.444.864-.608 1.249a18.348 18.348 0 0 0-5.495 0 12.643 12.643 0 0 0-.617-1.249.073.073 0 0 0-.074-.034 19.736 19.736 0 0 0-4.885 1.515.066.066 0 0 0-.03.027C.533 9.045-.32 13.579.099 18.057a.082.082 0 0 0 .031.057 19.91 19.91 0 0 0 5.993 3.029.077.077 0 0 0 .084-.028c.462-.63.873-1.295 1.226-1.994a.076.076 0 0 0-.041-.105 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.128 12.298 12.298 0 0 1-1.873.891.077.077 0 0 0-.041.106c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.029 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.548-13.66a.06.06 0 0 0-.031-.028zM8.02 15.331c-1.182 0-2.156-1.085-2.156-2.418 0-1.334.955-2.419 2.156-2.419 1.21 0 2.175 1.094 2.156 2.419 0 1.333-.955 2.418-2.156 2.418zm7.974 0c-1.183 0-2.157-1.085-2.157-2.418 0-1.334.955-2.419 2.157-2.419 1.21 0 2.175 1.094 2.156 2.419 0 1.333-.946 2.418-2.156 2.418z"/>
        </svg>
        Join Discord
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: var(--border-strong);
  }
  .inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  .brand-logo {
    display: block;
    width: 36px;
    height: 36px;
  }
  .wordmark {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    margin-left: 12px;
  }
  .nav-link {
    padding: 7px 12px;
    border-radius: 5px;
    font-weight: 600;
    font-size: 13px;
    color: var(--ink);
    text-decoration: none;
    transition: background .12s;
  }
  .nav-link:hover { background: var(--line); }
  .nav-link.active {
    background: var(--ink);
    color: var(--paper);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .merch {
    font-weight: 600;
    font-size: 13px;
    color: var(--ink);
    text-decoration: none;
  }
  .merch:hover { color: var(--brand); }
  .discord-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--discord);
    color: #fff;
    border-radius: 6px;
    padding: 9px 16px;
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    border: 2px solid var(--discord);
    transition: var(--tap);
  }
  .discord-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 0 var(--ink);
  }
  @media (max-width: 980px) {
    .nav { display: none; }
    .inner { padding: 12px 18px; gap: 12px; }
    .merch { display: none; }
  }
</style>
