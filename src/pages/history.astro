---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'history');
const { Content } = await render(entry!);
---
<BaseLayout title="History">
  <section class="page-head">
    <div class="container-mid">
      <Eyebrow>Founded May 25, 2018</Eyebrow>
      <h1 class="h1-page">League History</h1>
      <p class="lead">
        Twenty-one seasons of competitive Polytopia, told through the people
        who shaped the league.
      </p>
    </div>
  </section>

  <section class="body-section">
    <div class="container-mid">
      <div class="body">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding: 56px 36px 20px; }
  .h1-page {
    font-size: var(--text-display-2);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0 0 14px 0;
  }
  .body-section { padding: 28px 36px 70px; }
  .body :global(h2) {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 40px 0 14px;
    padding-top: 28px;
    border-top: var(--border-subtle);
  }
  .body :global(h2:first-of-type) { padding-top: 0; border-top: 0; margin-top: 8px; }
  .body :global(p) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
    margin: 0 0 1em 0;
  }
  .body :global(ul) { padding-left: 1.2em; }
  .body :global(li) { margin-bottom: 0.4em; color: var(--ink-2); }
  .body :global(img) {
    border: var(--border-strong);
    border-radius: var(--radius);
    margin: 18px 0;
  }
  .body :global(a) { color: var(--ink); border-bottom: 2px solid var(--ink); }
  .body :global(a:hover) { color: var(--brand); border-color: var(--brand); }
  .body :global(code) {
    font-family: var(--font-mono);
    background: var(--paper-2);
    border: var(--border-subtle);
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 0.92em;
  }
</style>
