---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Accordion from '../components/Accordion.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'faq');
const raw = entry?.body ?? '';

type Item = { question: string; answer: string };
const items: Item[] = [];
const sections = raw.split(/\n(?=## )/);
for (const sec of sections) {
  const m = sec.match(/^##\s+(.+?)\n([\s\S]*)$/);
  if (!m) continue;
  items.push({ question: m[1].trim(), answer: m[2].trim() });
}

function mdToHtml(md: string): string {
  const lines = md.split('\n');
  const out: string[] = [];
  let para: string[] = [];
  let list: string[] = [];

  const flushPara = () => {
    if (para.length) {
      out.push('<p>' + inline(para.join(' ').trim()) + '</p>');
      para = [];
    }
  };
  const flushList = () => {
    if (list.length) {
      out.push('<ul>' + list.map((l) => '<li>' + inline(l) + '</li>').join('') + '</ul>');
      list = [];
    }
  };

  for (const ln of lines) {
    if (/^\s*-\s+/.test(ln)) {
      flushPara();
      list.push(ln.replace(/^\s*-\s+/, ''));
    } else if (ln.trim() === '') {
      flushPara();
      flushList();
    } else {
      flushList();
      para.push(ln.trim());
    }
  }
  flushPara();
  flushList();
  return out.join('\n');
}

function inline(s: string): string {
  return s
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');
}
---
<BaseLayout title="FAQ">
  <section class="page-head">
    <div class="container-narrow">
      <Eyebrow>Frequently asked</Eyebrow>
      <h1 class="h1-page">Questions</h1>
    </div>
  </section>

  <section class="faq">
    <div class="container-narrow">
      <div class="faq-list">
        {items.map((it, i) => (
          <Accordion question={it.question} open={i === 0}>
            <div set:html={mdToHtml(it.answer)} />
          </Accordion>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding: 56px 36px 20px; }
  .h1-page {
    font-size: var(--text-display-2);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .faq { padding: 20px 36px 70px; }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
</style>
